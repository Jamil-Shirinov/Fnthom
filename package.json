{
  "name": "fnthom",
  "displayName": "Fnthom",
  "description": "Plan features with an AI agent one function at a time, then see how your functions connect and jump to their code.",
  "version": "0.3.0",
  "publisher": "calhacks-13",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jamil-Shirinov/Fnthom"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "fnthom.open",
        "title": "Open Panel",
        "category": "Fnthom"
      },
      {
        "command": "fnthom.setApiKey",
        "title": "Set Factory API Key",
        "category": "Fnthom"
      },
      {
        "command": "fnthom.export",
        "title": "Export Feature Reference",
        "category": "Fnthom"
      },
      {
        "command": "fnthom.resetSession",
        "title": "Reset Session",
        "category": "Fnthom"
      }
    ],
    "configuration": {
      "title": "Fnthom",
      "properties": {
        "fnthom.droidExecutablePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the droid CLI. Leave empty to discover it on PATH."
        },
        "fnthom.modelId": {
          "type": "string",
          "default": "",
          "description": "Optional Droid model ID. Leave empty to use the account's default model."
        },
        "fnthom.useFakeAgent": {
          "type": "boolean",
          "default": true,
          "description": "Use the scripted fake agent (it knows the caching demo in demo/app) instead of Factory Droid."
        },
        "fnthom.checks": {
          "type": "array",
          "default": [],
          "description": "Checks the extension runs after writing the feature's code. Each entry: id, label, executable, args, cwd (workspace-relative), timeoutMs.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "executable"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "executable": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "timeoutMs": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "dev": "node scripts/build-extension.mjs --watch & vite build --config webview/vite.config.ts --watch",
    "dev:webview": "vite --config webview/vite.config.ts",
    "build": "node scripts/build-extension.mjs && vite build --config webview/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "test": "vitest run",
    "check:offline": "npm test && npm run build",
    "package": "npm run build && vsce package --no-dependencies",
    "demo:reset": "git restore --source=HEAD --staged --worktree -- demo/app && git clean -fd -- demo/app/src demo/app/test",
    "preview:fixture": "esbuild scripts/preview-fixture.ts --bundle --platform=node --format=cjs --log-level=warning | node -"
  },
  "dependencies": {
    "@factory/droid-sdk": "^0.10.0",
    "typescript": "5.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@dagrejs/dagre": "1.1.5",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/vscode": "1.90.0",
    "@vitejs/plugin-react": "4.5.2",
    "@vscode/vsce": "3.6.2",
    "@xyflow/react": "12.8.6",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.3.7",
    "vitest": "3.2.7"
  }
}
